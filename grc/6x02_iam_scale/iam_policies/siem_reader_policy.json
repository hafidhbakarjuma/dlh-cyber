{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SIEMBucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::meddefense-siemlog-prod",
        "arn:aws:s3:::meddefense-siemlog-prod/*"
      ]
    },
    {
      "Sid": "SIEMCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/siem-log-reader:*"
    }
  ]
}
