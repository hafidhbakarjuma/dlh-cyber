{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EHRBackupS3Access",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::meddefense-ehr-backup-prod",
        "arn:aws:s3:::meddefense-ehr-backup-prod/*"
      ]
    },
    {
      "Sid": "EHRBackupKMSAccess",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:us-east-1:123456789012:key/mrk-abc123def456"
    }
  ]
}
