# MedDefense Custom Detection Rules (SID range 9000001 - 9000006)

# 1. Med device to Internet (excluding NTP udp/123)
alert ip 10.10.4.0/24 any -> !$HOME_NET ![123] (msg:"MEDDEV to Internet Unauthorized Traffic"; ip.proto = tcp; sid:9000001; rev:1; classtype:policy-violation;)
alert ip 10.10.4.0/24 any -> !$HOME_NET ![123] (msg:"MEDDEV to Internet Unauthorized Traffic"; ip.proto = udp; sid:9000001; rev:1; classtype:policy-violation;)

# 2. Unauthorized SMB from guest network to HOME_NET
alert tcp 10.10.5.0/24 any -> $HOME_NET 445 (msg:"Guest Network Unauthorized SMB Access"; sid:9000002; rev:1; classtype:attempted-recon;)

# 3. Large outbound from server (Threshold-based: >50MB TCP payload in 300s window)
alert tcp 10.10.1.0/24 any -> !$HOME_NET any (msg:"Large Outbound Data Transfer from Server Zone"; threshold: type both, track by_src, count 1000, seconds 300; sid:9000003; rev:1; classtype:policy-violation;)

# 4. DNS tunneling (Leftmost DNS query label exceeds 50 characters)
alert dns any any -> any any (msg:"DNS Tunneling Long Label Detected"; dns.query; content:!"google"; depth:50; pcre:"/^[a-zA-Z0-9-]{51,}\./"; sid:9000004; rev:1; classtype:trojan-activity;)

# 5. Clinical workstation to unauthorized database (tcp/3306, excluding authorized billing db IP e.g., 10.10.1.50)
alert tcp 10.10.2.0/24 any -> !10.10.1.50 3306 (msg:"Clinical Workstation to Unauthorized Database"; sid:9000005; rev:1; classtype:attempted-access;)

# 6. Telnet cleartext to medical device zone (tcp/23 to 10.10.4.0/24)
alert tcp any any -> 10.10.4.0/24 23 (msg:"Cleartext Telnet to Medical Device Zone"; sid:9000006; rev:1; classtype:protocol-command-decode;)
